@startuml
!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Person(sre, "SRE / Developer", "Asks topology questions about the cluster")
System(k8s, "Kubernetes Cluster", "Live K8s API")
System_Ext(snapshot, "Snapshot Directory", "On-disk JSON snapshots")
System_Ext(agent, "Coding Agent", "Codex / Claude Code / etc.")
System_Ext(llm, "LLM Provider", "OpenAI / Gemini / etc.")

Container_Boundary(ariadne, "k8s-graph-rs") {
  Container(rust_mcp, "ariadne-mcp", "Rust", "HTTP server exposing graph_query, graph_schema, graph_health plus render/debug routes")
  Container(rust_core, "ariadne-core", "Rust", "Kube clients, snapshot resolver, derived graph model, graph backends, query issue classification")
  Container(rust_tools, "ariadne-tools", "Rust", "Schema and prompt generation used by graph_schema")
  Container(rust_cypher, "ariadne-cypher", "Rust", "Cypher parser, AST, and semantic validation")
  Container(rust_cli, "ariadne-cli", "Rust", "Local GUI/debug harness with optional Memgraph or in-memory execution")
  Container(py_agent, "python/agent", "Python", "MCP client, ADK translator, bridge, and evaluation harness")
}

Container(memgraph, "Memgraph", "GraphDB", "Default graph backend for ariadne-mcp")

Rel(sre, agent, "Asks questions", "Chat/CLI")
Rel(sre, rust_cli, "Uses for local debugging / demos", "GUI")
Rel(sre, py_agent, "Uses for local experiments / evals", "CLI")
Rel(agent, rust_mcp, "Calls MCP tools", "Streamable HTTP")
Rel(py_agent, rust_mcp, "Calls MCP tools", "HTTP/JSON-RPC")
Rel(py_agent, llm, "Prompts for NL -> Cypher", "HTTPS")
Rel(rust_cli, llm, "Prompts for translation / analysis", "HTTPS")
Rel(rust_mcp, rust_core, "Uses resolver, shared cluster state, backends", "in-process")
Rel(rust_mcp, rust_tools, "Builds compact / structured schema responses", "in-process")
Rel(rust_tools, rust_core, "Uses graph types and relationships", "in-process")
Rel(rust_core, rust_cypher, "Parses and validates Cypher", "in-process")
Rel(rust_core, memgraph, "Creates / updates / queries graph", "Bolt")
Rel(rust_core, k8s, "Lists and watches resources", "K8s API")
Rel(rust_core, snapshot, "Loads snapshots via SnapshotKubeClient", "Local files")
Rel(rust_mcp, snapshot, "Exports observed snapshots", "JSON files")
Rel(rust_cli, rust_core, "Uses resolver, validation, and snapshot loading", "in-process")
Rel(rust_cli, memgraph, "Optionally queries via MemgraphAsync", "Bolt")
@enduml
